# 复制为 .env 后按需修改。所有项都有默认值，零配置可跑（LLM 会自动降级为规则归因）。

# ---------- 存储 ----------
STAGUARD_DB_URL=sqlite:///./data/staguard.db
# PostgreSQL 示例（依赖 psycopg[binary]）：
# STAGUARD_DB_URL=postgresql+psycopg://staguard:staguard@127.0.0.1:5432/staguard

# ---------- 巡检 ----------
STAGUARD_WINDOW_MINUTES=30
STAGUARD_GRANULARITY_SECONDS=60
STAGUARD_BASELINE_DAYS=14
# 低于该样本量即回退静态阈值（调到远超样本量可复现「全部回退」的情形）
STAGUARD_BASELINE_MIN_SAMPLES=30
STAGUARD_DEFAULT_SOURCE=file
# 不带场景巡检时，用哪份切片代表「当前水位」（仅内置 file / 模拟接口数据源有效）
STAGUARD_LIVE_DATASET=S0

# ---------- AI 智能分析 ----------
STAGUARD_LLM_ENABLED=true
STAGUARD_LLM_PROVIDER=deepseek
STAGUARD_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
STAGUARD_LLM_BASE_URL=https://api.deepseek.com
STAGUARD_LLM_MODEL=deepseek-chat
STAGUARD_LLM_MAX_ATTEMPTS=2

# 无 key 时演示用：STAGUARD_LLM_PROVIDER=mock

# ---------- 告警推送 ----------
STAGUARD_ALERT_DRY_RUN=true
# STAGUARD_ALERT_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
STAGUARD_ALERT_MIN_LEVEL=P2

# ---------- 日志 ----------
STAGUARD_LOG_LEVEL=INFO
STAGUARD_LOG_FORMAT=console
